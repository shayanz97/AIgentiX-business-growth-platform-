# Copy to apps/api/.env for running the API outside Docker. Never commit real values.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql://aigentix:change-me@localhost:5432/aigentix
CORS_ORIGINS=http://localhost:3000
# Set to false only for local plain-HTTP development.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_RUN_MINUTES=30
# Path to alembic.ini (relative to the working directory); /ready uses it to verify the migration head.
ALEMBIC_INI=alembic.ini
WORKER_RETRY_BASE_SECONDS=30

# --- Lead Intelligence research ---
# internet = real public websites (SSRF-protected); fixtures = bundled *.example sites (tests/demos, not production)
RESEARCH_FETCH_BACKEND=internet
RESEARCH_USER_AGENT=AIgentiXResearchBot/0.2 (+https://aigentix.example/bot)
RESEARCH_MAX_PAGES=8
RESEARCH_HTTP_TIMEOUT_SECONDS=10
RESEARCH_MAX_RESPONSE_BYTES=2000000
RESEARCH_MAX_TEXT_CHARS=20000
RESEARCH_DOMAIN_MIN_INTERVAL_SECONDS=0.5
RESEARCH_MAX_CONCURRENT_RUNS=2
RESEARCH_MAX_ATTEMPTS=3
RESEARCH_IMPORT_MAX_ROWS=100
RESEARCH_IMPORT_MAX_BYTES=524288

# --- LLM --- anthropic | fixture (offline test double, refused in production) | none
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-haiku-5-5
LLM_AUDIT_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_REPAIRS=2
LLM_SERVER_SIDE_FALLBACK=true
LLM_MAX_COST_PER_RUN_USD=0.50
