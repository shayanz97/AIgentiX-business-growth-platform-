# Docker Compose configuration. Copy to .env and replace placeholders. Never commit .env.
POSTGRES_USER=aigentix
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aigentix
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Local Docker serves plain HTTP, so the Secure cookie flag must be off locally. Keep true behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Lead Intelligence research. Without ANTHROPIC_API_KEY research still runs, but AI analysis is reported
# as unavailable (no opportunities are generated). Never commit a real key.
RESEARCH_FETCH_BACKEND=internet
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-haiku-5-5
LLM_AUDIT_MODEL=claude-opus-5-5
LLM_MAX_COST_PER_RUN_USD=0.50
# Host ports (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
